NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/insightpay
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Logging: debug | info | warn | error (defaults to debug in dev, info in prod)
LOG_LEVEL=debug

# Email
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@insightpay.ng

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# NIN (QoreID recommended  see https://docs.qoreid.com/reference)
NIN_PROVIDER=qoreid
QOREID_CLIENT_ID=
QOREID_SECRET=
QOREID_API_URL=https://api.qoreid.com

# Legacy NUBAN provider (optional)
NUBAN_API_KEY=
NUBAN_API_URL=https://api.nuban.com.ng/v1
NIN_ENCRYPTION_KEY=32-char-secret-key-change-me!!

# Liveness (QoreID Web SDK  NIN liveness product code)
FEATURE_LIVENESS=true
LIVENESS_PROVIDER=qoreid
QOREID_NIN_LIVENESS_PRODUCT_CODE=liveness_nin

# Platform
PLATFORM_FEE_PERCENT=25
MIN_WITHDRAWAL_AMOUNT=100
AUTO_APPROVE_RESPONSES=true
FEATURE_TIME_BASED_PRICING=true
FEATURE_PREMIUM_MULTIPLIER=true

# DeepSeek AI (https://api-docs.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
FEATURE_AI_SPAM_FILTER=true
FEATURE_AI_ANALYTICS=true
AI_SPAM_FILTER_COST_PER_RESPONSE=20
AI_ANALYTICS_COST=5000
