NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/insightpay
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Email
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@insightpay.ng

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# NIN
NIN_PROVIDER=mock
NUBAN_API_KEY=
NUBAN_API_URL=https://api.nuban.com.ng/v1
NIN_ENCRYPTION_KEY=32-char-secret-key-change-me!!

# Liveness
FEATURE_LIVENESS=false
LIVENESS_PROVIDER=mock

# Platform
PLATFORM_FEE_PERCENT=15
MIN_WITHDRAWAL_AMOUNT=1000
AUTO_APPROVE_RESPONSES=true
